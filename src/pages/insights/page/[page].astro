---
import { getCollection, getEntry } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InsightCard from '../../../components/sections/InsightCard.astro';

// Pages 2+ of the insights archive. Page 1 is served by /insights/index.astro.
// Pagination infrastructure: paginate() returns all pages; we filter to page 2+
// (page 1 has params.page === undefined) to avoid a routing conflict with index.astro.

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allArticles = (await getCollection('insights', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
  );
  const allPages = paginate(allArticles, { pageSize: 9 });
  // Filter to pages 2+ — page 1 (params.page === undefined) is served by index.astro
  return allPages.filter((p) => p.params.page !== undefined);
};

const { page } = Astro.props as { page: Page<CollectionEntry<'insights'>> };

// Resolve authors for this page's articles
const resolvedArticles = await Promise.all(
  page.data.map(async (article) => {
    const attorney = await getEntry('attorneys', article.data.author);
    return {
      title: article.data.title,
      slug: article.id,
      publishDate: article.data.publishDate,
      practiceAreas: article.data.practiceAreas,
      excerpt: article.data.excerpt,
      resolvedAuthor: attorney
        ? { name: attorney.data.name, slug: attorney.id }
        : { name: article.data.author, slug: article.data.author },
    };
  })
);

// Filter strip: practices with ≥1 published insight
const allInsights = await getCollection('insights', ({ data }) => !data.draft);
const practicesWithInsights = new Set(allInsights.flatMap((i) => i.data.practiceAreas));
const allPractices = (await getCollection('practice-areas'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((p) => practicesWithInsights.has(p.id));

// Prev link: page 2's previous page is the index (/insights), not /insights/page/1
const B = import.meta.env.BASE_URL;
const prevUrl =
  page.currentPage === 2 ? `${B}insights` : `${B}insights/page/${page.currentPage - 1}`;
---

<BaseLayout
  title={`Insights — Page ${page.currentPage} | Stream Kim Hicks Wrage & Alfaro, P.C.`}
  description="Perspectives on civil litigation, public entity law, healthcare regulation, and construction from the attorneys of Stream Kim."
>
  <div class="bg-bone py-20 lg:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <header class="mb-12">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brass mb-4">
          Publications
        </p>
        <h1
          class="font-display text-4xl lg:text-5xl font-medium text-charcoal leading-snug
                 tracking-[-0.02em]"
        >
          Insights
        </h1>
        <p class="mt-4 text-lg text-midgray max-w-2xl leading-relaxed">
          Perspectives on civil litigation, public entity law, healthcare regulation, and
          construction from the attorneys of Stream Kim.
        </p>
      </header>

      <!-- Filter strip -->
      {allPractices.length > 0 && (
        <nav aria-label="Filter by practice area" class="mb-10">
          <ul class="flex flex-wrap gap-2">
            <li>
              <a
                href={`${B}insights`}
                class="inline-block text-sm px-3 py-1.5 border border-charcoal/20
                       text-charcoal hover:border-bordeaux hover:text-bordeaux
                       transition-colors duration-150"
              >
                All
              </a>
            </li>
            {allPractices.map((p) => (
              <li>
                <a
                  href={`${B}insights/practice/${p.id}`}
                  class="inline-block text-sm px-3 py-1.5 border border-charcoal/20
                         text-charcoal hover:border-bordeaux hover:text-bordeaux
                         transition-colors duration-150"
                >
                  {p.data.name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <!-- Article grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {resolvedArticles.map((article) => (
          <InsightCard
            title={article.title}
            slug={article.slug}
            publishDate={article.publishDate}
            author={article.resolvedAuthor}
            practiceAreas={article.practiceAreas}
            excerpt={article.excerpt}
          />
        ))}
      </div>

      <!-- Pagination nav -->
      {page.lastPage > 1 && (
        <nav aria-label="Pagination" class="mt-12 flex items-center justify-center gap-6">
          <a
            href={prevUrl}
            class="text-sm text-charcoal hover:text-bordeaux transition-colors duration-150"
          >
            ← Previous
          </a>
          <span class="text-sm text-midgray">
            Page {page.currentPage} of {page.lastPage}
          </span>
          {page.url.next && (
            <a
              href={page.url.next}
              class="text-sm text-charcoal hover:text-bordeaux transition-colors duration-150"
            >
              Next →
            </a>
          )}
        </nav>
      )}

    </div>
  </div>
</BaseLayout>
