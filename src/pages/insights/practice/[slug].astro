---
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InsightCard from '../../../components/sections/InsightCard.astro';

export async function getStaticPaths() {
  const practices = await getCollection('practice-areas');
  const allArticles = (await getCollection('insights', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
  );

  // Only generate a page for practices that have at least one published insight
  return practices
    .map((practice) => ({
      practice,
      articles: allArticles.filter((a) => a.data.practiceAreas.includes(practice.id)),
    }))
    .filter(({ articles }) => articles.length > 0)
    .map(({ practice, articles }) => ({
      params: { slug: practice.id },
      props: { practice, articles },
    }));
}

const {
  practice,
  articles,
}: {
  practice: CollectionEntry<'practice-areas'>;
  articles: CollectionEntry<'insights'>[];
} = Astro.props;

// Resolve authors for each article
const resolvedArticles = await Promise.all(
  articles.map(async (article) => {
    const attorney = await getEntry('attorneys', article.data.author);
    return {
      title: article.data.title,
      slug: article.id,
      publishDate: article.data.publishDate,
      practiceAreas: article.data.practiceAreas,
      excerpt: article.data.excerpt,
      resolvedAuthor: attorney
        ? { name: attorney.data.name, slug: attorney.id }
        : { name: article.data.author, slug: article.data.author },
    };
  })
);

// Filter strip: all practices with ≥1 published insight
const allInsights = await getCollection('insights', ({ data }) => !data.draft);
const practicesWithInsights = new Set(allInsights.flatMap((i) => i.data.practiceAreas));
const allPractices = (await getCollection('practice-areas'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((p) => practicesWithInsights.has(p.id));
---

<BaseLayout
  title={`${practice.data.name} Insights | Stream Kim Hicks Wrage & Alfaro, P.C.`}
  description={`Analysis and updates on ${practice.data.name.toLowerCase()} from the attorneys of Stream Kim.`}
>
  <div class="bg-bone py-20 lg:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <header class="mb-12">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brass mb-4">
          Publications
        </p>
        <h1
          class="font-display text-4xl lg:text-5xl font-medium text-charcoal leading-snug
                 tracking-[-0.02em]"
        >
          {practice.data.name}
        </h1>
        <p class="mt-4 text-lg text-midgray max-w-2xl leading-relaxed">
          Insights on {practice.data.name.toLowerCase()} from Stream Kim's attorneys.
        </p>
      </header>

      <!-- Filter strip: current practice is active -->
      {allPractices.length > 0 && (
        <nav aria-label="Filter by practice area" class="mb-10">
          <ul class="flex flex-wrap gap-2">
            <li>
              <a
                href={`${import.meta.env.BASE_URL}insights`}
                class="inline-block text-sm px-3 py-1.5 border border-charcoal/20
                       text-charcoal hover:border-bordeaux hover:text-bordeaux
                       transition-colors duration-150"
              >
                All
              </a>
            </li>
            {allPractices.map((p) => (
              <li>
                <a
                  href={`${import.meta.env.BASE_URL}insights/practice/${p.id}`}
                  aria-current={p.id === practice.id ? 'page' : undefined}
                  class={
                    p.id === practice.id
                      ? 'inline-block text-sm px-3 py-1.5 border border-bordeaux text-bordeaux font-medium'
                      : 'inline-block text-sm px-3 py-1.5 border border-charcoal/20 text-charcoal hover:border-bordeaux hover:text-bordeaux transition-colors duration-150'
                  }
                >
                  {p.data.name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <!-- Article grid -->
      {resolvedArticles.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {resolvedArticles.map((article) => (
            <InsightCard
              title={article.title}
              slug={article.slug}
              publishDate={article.publishDate}
              author={article.resolvedAuthor}
              practiceAreas={article.practiceAreas}
              excerpt={article.excerpt}
            />
          ))}
        </div>
      ) : (
        <p class="text-midgray">No articles have been published for this practice area yet.</p>
      )}

    </div>
  </div>
</BaseLayout>
