---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotableMatterCard from '../../components/sections/NotableMatterCard.astro';

const allMatters = (await getCollection('notable-matters')).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)
);

// Filter strip: practice areas that have at least one matter, sorted by strategic order
const practicesWithMatters = new Set(allMatters.map((m) => m.data.practiceArea));
const allPractices = (await getCollection('practice-areas'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((p) => practicesWithMatters.has(p.id));

const B = import.meta.env.BASE_URL;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(B, Astro.site).href },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Representative Matters',
      item: Astro.url.href,
    },
  ],
};
---

<BaseLayout
  title="Representative Matters | Stream Kim Hicks Wrage & Alfaro, P.C."
  description="Representative matters from Stream Kim's civil litigation practice across public entity defense, healthcare law, employment law, real estate, and construction."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <!-- Page header and filter strip -->
  <div class="bg-bone py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <header class="mb-10">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brass mb-4">
          The Firm's Work
        </p>
        <h1
          class="font-display text-4xl lg:text-5xl font-medium text-charcoal leading-snug
                 tracking-[-0.02em]"
        >
          Representative Matters
        </h1>
        <p class="mt-4 text-lg text-midgray max-w-2xl leading-relaxed">
          Stream Kim has represented institutions across California in a wide range of complex
          civil disputes. The following matters are representative of the firm's work and are
          described in accordance with California Rules of Professional Conduct.
        </p>
      </header>

      <!-- Filter strip -->
      {allPractices.length > 0 && (
        <nav aria-label="Filter by practice area">
          <ul class="flex flex-wrap gap-2">
            <li>
              <a
                href={`${B}notable-matters`}
                aria-current="page"
                class="inline-block text-sm px-3 py-1.5 border border-bordeaux text-bordeaux
                       font-medium"
              >
                All
              </a>
            </li>
            {allPractices.map((p) => (
              <li>
                <a
                  href={`${B}notable-matters/practice/${p.id}`}
                  class="inline-block text-sm px-3 py-1.5 border border-charcoal/20
                         text-charcoal hover:border-bordeaux hover:text-bordeaux
                         transition-colors duration-150"
                >
                  {p.data.name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

    </div>
  </div>

  <!-- Matters grid -->
  <div class="bg-charcoal py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- TODO: add pagination if matters exceed 12 -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {allMatters.map((matter) => (
          <NotableMatterCard
            title={matter.data.title}
            practiceArea={matter.data.practiceArea}
            description={matter.data.description}
            outcome={matter.data.outcome}
          />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
