---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionDivider from '../../components/ui/SectionDivider.astro';
import ContactCTA from '../../components/sections/ContactCTA.astro';
import AttorneyHero from '../../components/sections/attorney/AttorneyHero.astro';
import AttorneyContact from '../../components/sections/attorney/AttorneyContact.astro';
import AttorneyNotableMatters from '../../components/sections/attorney/AttorneyNotableMatters.astro';
import AttorneyPracticeAreas from '../../components/sections/attorney/AttorneyPracticeAreas.astro';
import AttorneyAuthoredInsights from '../../components/sections/attorney/AttorneyAuthoredInsights.astro';
import AttorneyCredentials from '../../components/sections/attorney/AttorneyCredentials.astro';
import AttorneyPublications from '../../components/sections/attorney/AttorneyPublications.astro';
import AttorneyRecognitions from '../../components/sections/attorney/AttorneyRecognitions.astro';
import AttorneyMemberships from '../../components/sections/attorney/AttorneyMemberships.astro';

export async function getStaticPaths() {
  const attorneys = await getCollection('attorneys');
  return attorneys.map((attorney) => ({
    params: { slug: attorney.id },
    props: { attorney },
  }));
}

const { attorney } = Astro.props;
const slug = attorney.id;

// Notable matters from collection — filters by attorneys[] containing this slug
const allMatters = await getCollection('notable-matters');
const collectionMatters = allMatters
  .filter((m) => m.data.attorneys?.includes(slug) ?? false)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .map((m) => ({
    title: m.data.title,
    practiceArea: m.data.practiceArea,
    description: m.data.description,
    outcome: m.data.outcome,
  }));

// Inline matters from attorney frontmatter (fallback / additional matters)
const inlineMatters = attorney.data.notableMatters ?? [];

// Resolve practice area names from slugs
const practiceEntries = await Promise.all(
  attorney.data.practiceAreas.map((s) => getEntry('practice-areas', s))
);
const practices = practiceEntries
  .filter(Boolean)
  .map((p) => ({ name: p!.data.name, slug: p!.id }));

// Authored insights (non-draft, by this attorney), newest-first, capped at 3
const authoredInsights = (
  await getCollection('insights', ({ data }) => !data.draft && data.author === slug)
)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3)
  .map((i) => ({
    title: i.data.title,
    slug: i.id,
    publishDate: i.data.publishDate,
    author: i.data.author,
    practiceAreas: i.data.practiceAreas,
    excerpt: i.data.excerpt,
  }));

// Practice options for the ContactCTA dropdown
const allPractices = (await getCollection('practice-areas')).sort(
  (a, b) => a.data.order - b.data.order
);
const practiceOptions = allPractices.map((p) => ({ slug: p.id, name: p.data.name }));

// Schema.org: Person + BreadcrumbList
const canonicalUrl = Astro.url.href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: attorney.data.name,
  jobTitle: attorney.data.title,
  worksFor: {
    '@type': 'Organization',
    name: 'Stream Kim Hicks Wrage & Alfaro, P.C.',
    url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  },
  url: canonicalUrl,
  ...(attorney.data.email && { email: `mailto:${attorney.data.email}` }),
  ...(attorney.data.phone && { telephone: attorney.data.phone }),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(import.meta.env.BASE_URL, Astro.site).href },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Attorneys',
      item: new URL(`${import.meta.env.BASE_URL}attorneys`, Astro.site).href,
    },
    { '@type': 'ListItem', position: 3, name: attorney.data.name, item: canonicalUrl },
  ],
};
---

<BaseLayout
  title={`${attorney.data.name} | Stream Kim Hicks Wrage & Alfaro, P.C.`}
  description={attorney.data.leadParagraph}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <AttorneyHero
    name={attorney.data.name}
    title={attorney.data.title}
    leadParagraph={attorney.data.leadParagraph}
    portrait={attorney.data.portrait}
  />

  <AttorneyContact
    name={attorney.data.name}
    slug={slug}
    email={attorney.data.email}
    phone={attorney.data.phone}
  />

  <AttorneyNotableMatters
    collectionMatters={collectionMatters}
    inlineMatters={inlineMatters}
  />

  <AttorneyPracticeAreas practices={practices} />

  <AttorneyAuthoredInsights articles={authoredInsights} />

  <AttorneyCredentials
    education={attorney.data.education}
    admissions={attorney.data.barAdmissions}
    clerkships={attorney.data.clerkships}
  />

  <AttorneyPublications
    publications={attorney.data.publications ?? []}
    speakingEngagements={attorney.data.speakingEngagements ?? []}
  />

  <AttorneyRecognitions honors={attorney.data.honors ?? []} />

  <AttorneyMemberships memberships={attorney.data.memberships ?? []} />

  <SectionDivider />

  <ContactCTA
    heading="Schedule a Consultation"
    formAction="[PLACEHOLDER — Formspree endpoint, see docs/launch-checklist.md]"
    practiceOptions={practiceOptions}
    id="contact"
  />
</BaseLayout>
