---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionDivider from '../../components/ui/SectionDivider.astro';
import PracticeHero from '../../components/sections/practice/PracticeHero.astro';
import PracticeOverview from '../../components/sections/practice/PracticeOverview.astro';
import PracticeCapabilities from '../../components/sections/practice/PracticeCapabilities.astro';
import PracticeRepresentativeMatters from '../../components/sections/practice/PracticeRepresentativeMatters.astro';
import PracticeAttorneys from '../../components/sections/practice/PracticeAttorneys.astro';
import PracticeRelatedInsights from '../../components/sections/practice/PracticeRelatedInsights.astro';
import PracticeJurisdiction from '../../components/sections/practice/PracticeJurisdiction.astro';
import PracticeFAQ from '../../components/sections/practice/PracticeFAQ.astro';
import PracticeCTA from '../../components/sections/practice/PracticeCTA.astro';

export async function getStaticPaths() {
  const practices = await getCollection('practice-areas');
  return practices.map((practice) => ({
    params: { slug: practice.id },
    props: { practice },
  }));
}

const { practice } = Astro.props;
const slug = practice.id;

// Render the markdown body
const { Content } = await render(practice);

// Attorneys active in this practice
const allAttorneys = await getCollection('attorneys');
const attorneys = allAttorneys
  .filter((a) => a.data.practiceAreas.includes(slug))
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

// Notable matters for this practice area
const allMatters = await getCollection('notable-matters');
const matters = allMatters
  .filter((m) => m.data.practiceArea === slug)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .slice(0, 10);

// Related insights (non-draft, tagged to this practice)
const allInsights = await getCollection('insights', ({ data }) => !data.draft);
const relatedInsights = allInsights
  .filter((i) => i.data.practiceAreas.includes(slug))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

// Practice options for the CTA dropdown
const allPractices = (await getCollection('practice-areas')).sort(
  (a, b) => a.data.order - b.data.order
);
const practiceOptions = allPractices.map((p) => ({ slug: p.id, name: p.data.name }));

// Shape data for section components
const attorneysForSection = attorneys.map((a) => ({
  name: a.data.name,
  slug: a.id,
  title: a.data.title,
  practiceAreas: a.data.practiceAreas,
  portrait: a.data.portrait,
}));

const mattersForSection = matters.map((m) => ({
  title: m.data.title,
  practiceArea: m.data.practiceArea,
  description: m.data.description,
  outcome: m.data.outcome,
}));

const insightsForSection = relatedInsights.map((i) => ({
  title: i.data.title,
  slug: i.id,
  publishDate: i.data.publishDate,
  author: i.data.author,
  practiceAreas: i.data.practiceAreas,
  excerpt: i.data.excerpt,
}));

// Schema.org: LegalService + BreadcrumbList (+ FAQPage if applicable)
const canonicalUrl = Astro.url.href;

const legalServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: `${practice.data.name} — Stream Kim Hicks Wrage & Alfaro, P.C.`,
  serviceType: practice.data.name,
  provider: {
    '@type': 'Organization',
    name: 'Stream Kim Hicks Wrage & Alfaro, P.C.',
    url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  },
  areaServed: { '@type': 'State', name: 'California' },
  url: canonicalUrl,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(import.meta.env.BASE_URL, Astro.site).href },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Practice Areas',
      item: new URL(`${import.meta.env.BASE_URL}practice-areas`, Astro.site).href,
    },
    { '@type': 'ListItem', position: 3, name: practice.data.name, item: canonicalUrl },
  ],
};

const faqItems = practice.data.faqItems ?? [];
const faqSchema =
  faqItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }
    : null;
---

<BaseLayout
  title={`${practice.data.name} | Stream Kim Hicks Wrage & Alfaro, P.C.`}
  description={practice.data.tagline}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(legalServiceSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
  </Fragment>

  <PracticeHero
    name={practice.data.name}
    heroBody={practice.data.heroBody}
    tagline={practice.data.tagline}
  />

  <PracticeOverview Content={Content} />

  <PracticeCapabilities capabilities={practice.data.capabilitiesList} />

  <PracticeRepresentativeMatters matters={mattersForSection} />

  <PracticeAttorneys attorneys={attorneysForSection} />

  <PracticeRelatedInsights articles={insightsForSection} />

  {practice.data.jurisdictionNotes && (
    <PracticeJurisdiction jurisdictionNotes={practice.data.jurisdictionNotes} />
  )}

  {faqItems.length > 0 && (
    <PracticeFAQ faqItems={faqItems} />
  )}

  <SectionDivider />

  <PracticeCTA
    practiceName={practice.data.name}
    practiceSlug={slug}
    formAction="[PLACEHOLDER — Formspree endpoint, see docs/launch-checklist.md]"
    practiceOptions={practiceOptions}
  />
</BaseLayout>
