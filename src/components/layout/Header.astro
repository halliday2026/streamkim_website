---
// Stub Header — full implementation (mega-menu, mobile drawer) in a later session.
// Active nav state is wired: currentPath is passed from BaseLayout via Astro.url.pathname.
import Button from '../ui/Button.astro';
import Link from '../ui/Link.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

// Returns true when the nav link's href matches the current page.
// For non-root links, matches on prefix so /practice-areas/[slug] activates "Practice Areas".
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

// Active class: bordeaux border-bottom. Base class preserves layout space for the
// underline on all links (border-transparent) to prevent layout shift on navigation.
const navClass = (href: string) =>
  isActive(href)
    ? 'border-b-2 border-bordeaux pb-0.5 text-bordeaux'
    : 'border-b-2 border-transparent pb-0.5';
---

<header role="banner" class="sticky top-0 z-50 bg-bone border-b border-charcoal/10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="h-16 flex items-center justify-between gap-8">

      <!-- Logo (text-only until SVG mark is provided) -->
      <a
        href="/"
        class="font-display text-xl font-medium text-charcoal tracking-[-0.01em] shrink-0
               hover:text-charcoal/80 focus-visible:outline-2 focus-visible:outline-charcoal focus-visible:outline-offset-2"
      >
        Stream Kim
      </a>

      <!-- Desktop nav -->
      <nav aria-label="Primary navigation" class="hidden lg:flex items-center gap-7">
        <Link href="/firm" variant="nav" class={navClass('/firm')}>Firm</Link>
        <Link href="/attorneys" variant="nav" class={navClass('/attorneys')}>Attorneys</Link>
        <Link href="/practice-areas" variant="nav" class={navClass('/practice-areas')}>Practice Areas</Link>
        <Link href="/insights" variant="nav" class={navClass('/insights')}>Insights</Link>
        <Link href="/notable-matters" variant="nav" class={navClass('/notable-matters')}>Notable Matters</Link>
        <Link href="/contact" variant="nav" class={navClass('/contact')}>Contact</Link>
      </nav>

      <!-- Right cluster -->
      <div class="flex items-center gap-4 shrink-0">
        <Button href="/contact" variant="primary" size="sm" class="hidden lg:inline-flex">
          Schedule Consultation
        </Button>

        <!-- Mobile hamburger (stub — no menu logic) -->
        <button
          type="button"
          aria-label="Open navigation menu"
          class="lg:hidden inline-flex items-center justify-center w-10 h-10 text-charcoal
                 hover:text-charcoal/70 focus-visible:outline-2 focus-visible:outline-charcoal focus-visible:outline-offset-2"
        >
          <svg width="20" height="14" viewBox="0 0 20 14" fill="none" aria-hidden="true">
            <rect width="20" height="2" rx="1" fill="currentColor"/>
            <rect y="6" width="20" height="2" rx="1" fill="currentColor"/>
            <rect y="12" width="20" height="2" rx="1" fill="currentColor"/>
          </svg>
        </button>
      </div>

    </div>
  </div>
</header>
