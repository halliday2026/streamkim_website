---
export interface FormFieldProps {
  id: string;
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'textarea';
  required?: boolean;
  placeholder?: string;
  helpText?: string;
  errorMessage?: string;
  rows?: number;
}

const {
  id,
  name,
  label,
  type = 'text',
  required = false,
  placeholder,
  helpText,
  errorMessage,
  rows = 4,
} = Astro.props as FormFieldProps;

const hasError = Boolean(errorMessage);
const helpId = helpText ? `${id}-help` : undefined;
const errorId = hasError ? `${id}-error` : undefined;

// aria-describedby lists all associated description elements
const describedBy = [helpId, errorId].filter(Boolean).join(' ') || undefined;

const inputClasses = [
  'block w-full border px-3 py-2 text-base text-charcoal bg-white',
  'placeholder:text-midgray',
  'focus:outline-none focus:ring-2 focus:ring-navy focus:border-navy',
  'transition-colors duration-150',
  hasError
    ? 'border-red-600 ring-1 ring-red-600'
    : 'border-gray-300',
].join(' ');
---

<div class="flex flex-col gap-1">
  <label
    for={id}
    class="block text-sm font-medium text-charcoal"
  >
    {label}
    {required && (
      <>
        <span aria-hidden="true" class="ml-0.5 text-oxblood">*</span>
        <span class="sr-only">(required)</span>
      </>
    )}
  </label>

  {type === 'textarea' ? (
    <textarea
      id={id}
      name={name}
      rows={rows}
      required={required || undefined}
      placeholder={placeholder}
      aria-describedby={describedBy}
      aria-invalid={hasError ? 'true' : undefined}
      class={inputClasses}
    />
  ) : (
    <input
      id={id}
      name={name}
      type={type}
      required={required || undefined}
      placeholder={placeholder}
      aria-describedby={describedBy}
      aria-invalid={hasError ? 'true' : undefined}
      class={inputClasses}
    />
  )}

  {helpText && (
    <p id={helpId} class="text-sm text-midgray">
      {helpText}
    </p>
  )}

  {hasError && (
    <p id={errorId} role="alert" class="text-sm text-red-700">
      {errorMessage}
    </p>
  )}
</div>
