---
// Consolidates Education, Bar & Court Admissions, and Clerkships under a single H2.
// Each sub-section renders only if its data is non-empty.
// The whole component renders only if at least one sub-section has data.

export interface EducationEntry {
  institution: string;
  degree: string;
  year: number;
  honors?: string;
}

export interface ClerkshipEntry {
  judge: string;
  court: string;
  years: string;
}

export interface AttorneyCredentialsProps {
  education: EducationEntry[];
  admissions: string[];       // barAdmissions from attorney frontmatter
  clerkships?: ClerkshipEntry[];
}

const { education, admissions, clerkships = [] } = Astro.props as AttorneyCredentialsProps;

const hasEducation = education.length > 0;
const hasAdmissions = admissions.length > 0;
const hasClerkships = clerkships.length > 0;
const hasAny = hasEducation || hasAdmissions || hasClerkships;
---

{hasAny && (
  <section aria-labelledby="credentials-heading" class="bg-white py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2
        id="credentials-heading"
        class="font-display text-3xl font-medium text-charcoal leading-snug tracking-[-0.01em] mb-10"
      >
        Credentials
      </h2>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

        <!-- Education -->
        {hasEducation && (
          <div>
            <h3 class="font-display text-lg font-medium text-charcoal mb-5">
              Education
            </h3>
            <ul class="space-y-4">
              {education.map((entry) => (
                <li>
                  <p class="text-base font-medium text-charcoal">{entry.institution}</p>
                  <p class="text-sm text-midgray">{entry.degree}, {entry.year}</p>
                  {entry.honors && (
                    <p class="text-sm text-midgray italic">{entry.honors}</p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Bar & Court Admissions -->
        {hasAdmissions && (
          <div>
            <h3 class="font-display text-lg font-medium text-charcoal mb-5">
              Bar &amp; Court Admissions
            </h3>
            <ul class="space-y-2">
              {admissions.map((admission) => (
                <li class="text-sm text-charcoal leading-relaxed">{admission}</li>
              ))}
            </ul>
          </div>
        )}

        <!-- Clerkships -->
        {hasClerkships && (
          <div>
            <h3 class="font-display text-lg font-medium text-charcoal mb-5">
              Clerkships
            </h3>
            <ul class="space-y-3">
              {clerkships.map((clerkship) => (
                <li>
                  <p class="text-sm font-medium text-charcoal">
                    {clerkship.judge}
                  </p>
                  <p class="text-sm text-midgray">{clerkship.court}</p>
                  <p class="text-sm text-midgray">{clerkship.years}</p>
                </li>
              ))}
            </ul>
          </div>
        )}

      </div>
    </div>
  </section>
)}
