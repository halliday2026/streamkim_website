---
export interface AttorneyHeroProps {
  name: string;
  title: string;
  leadParagraph: string;
  portrait?: string;
}

const { name, title, leadParagraph, portrait } = Astro.props as AttorneyHeroProps;

const hasRealPortrait =
  Boolean(portrait) && !portrait!.startsWith('[PLACEHOLDER');

const isPlaceholderName = name.includes('[PLACEHOLDER');
const initials = isPlaceholderName
  ? ''
  : name
      .split(' ')
      .filter((_, i, arr) => i === 0 || i === arr.length - 1)
      .map((w) => w[0])
      .join('');
---

<section aria-labelledby="attorney-name-heading" class="bg-bone py-16 lg:py-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-10 lg:gap-16 items-start">

      <!-- Portrait -->
      <div class="aspect-square w-full max-w-[280px] mx-auto lg:mx-0 overflow-hidden
                  bg-gray-100 flex items-center justify-center shrink-0">
        {hasRealPortrait ? (
          <img
            src={`/src/assets/attorneys/${portrait}`}
            alt={`${name}, ${title}, Stream Kim Hicks Wrage & Alfaro`}
            class="w-full h-full object-cover"
            loading="eager"
          />
        ) : isPlaceholderName ? (
          <svg
            aria-hidden="true"
            viewBox="0 0 48 48"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-24 h-24 text-gray-300"
          >
            <circle cx="24" cy="16" r="8" />
            <path d="M6 44c0-9.941 8.059-18 18-18s18 8.059 18 18" />
          </svg>
        ) : (
          <span class="text-5xl font-display text-midgray select-none" aria-hidden="true">
            {initials}
          </span>
        )}
      </div>

      <!-- Bio text -->
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brass mb-4">
          {title}
        </p>
        <h1
          id="attorney-name-heading"
          class="font-display text-4xl lg:text-5xl font-medium text-charcoal leading-snug tracking-[-0.02em]"
        >
          {name}
        </h1>
        <p class="mt-6 text-lg text-charcoal/80 leading-relaxed max-w-2xl">
          {leadParagraph}
        </p>
      </div>

    </div>
  </div>
</section>
