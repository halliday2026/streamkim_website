---
// portrait is typed as string (not ImageMetadata) until real portrait files are available.
// See docs/component-library.md AttorneyCard section for migration notes.
export interface AttorneyCardProps {
  name: string;
  slug: string;
  title: string;
  practiceAreas: string[];
  portrait?: string;
}

const { name, slug, title, practiceAreas, portrait } = Astro.props as AttorneyCardProps;

const hasRealPortrait = Boolean(portrait) && !portrait!.startsWith('[PLACEHOLDER');

const displayedPractices = practiceAreas.slice(0, 2);

// Placeholder detection: names that haven't been authored yet follow the
// "[PLACEHOLDER — ...]" convention from CLAUDE.md. Extracting initials from
// these strings produces gibberish like "[n", so we skip initials entirely
// and fall back to a person silhouette. Real names (no "[PLACEHOLDER")
// extract first and last initial as before.
const isPlaceholderName = name.includes('[PLACEHOLDER');
const initials = isPlaceholderName
  ? ''
  : name
      .split(' ')
      .filter((_, i, arr) => i === 0 || i === arr.length - 1)
      .map((w) => w[0])
      .join('');
---

<article class="bg-white border border-gray-200 hover:border-charcoal transition-colors duration-150">
  <!-- Portrait area -->
  <div class="aspect-square w-full overflow-hidden bg-gray-100 flex items-center justify-center">
    {hasRealPortrait ? (
      <img
        src={`/src/assets/attorneys/${portrait}`}
        alt={`${name}, ${title}, Stream Kim Hicks Wrage & Alfaro`}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    ) : isPlaceholderName ? (
      /* Person silhouette — rendered when name is a placeholder string.
         Inline SVG avoids external dependencies; currentColor inherits midgray
         from the parent so it reads as muted, not as a real graphic. */
      <svg
        aria-hidden="true"
        viewBox="0 0 48 48"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="w-16 h-16 text-gray-300"
      >
        <circle cx="24" cy="16" r="8" />
        <path d="M6 44c0-9.941 8.059-18 18-18s18 8.059 18 18" />
      </svg>
    ) : (
      <span class="text-3xl font-display text-midgray select-none" aria-hidden="true">
        {initials}
      </span>
    )}
  </div>

  <!-- Info -->
  <div class="p-5">
    <p class="text-xs font-semibold tracking-widest uppercase text-midgray mb-1">
      {title}
    </p>
    <h3 class="font-display text-xl font-medium text-charcoal">
      <a
        href={`/attorneys/${slug}`}
        class="hover:underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-charcoal focus-visible:outline-offset-2"
      >
        {name}
      </a>
    </h3>
    {displayedPractices.length > 0 && (
      <p class="mt-2 text-sm text-midgray">
        {displayedPractices.join(' · ')}
      </p>
    )}
  </div>
</article>
