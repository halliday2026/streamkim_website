---
import NotableMatterCard from './NotableMatterCard.astro';
import Link from '../ui/Link.astro';

export interface NotableMattersStripProps {
  matters: Array<{
    title: string;
    practiceArea: string;
    description: string;
    outcome?: string;
  }>;
  viewAllHref: string;
}

const { matters, viewAllHref } = Astro.props as NotableMattersStripProps;
---

{matters.length > 0 && (
  <section aria-labelledby="matters-heading" class="py-16 lg:py-20 bg-navy">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2
        id="matters-heading"
        class="font-display text-3xl lg:text-4xl font-normal text-white leading-snug tracking-[-0.01em] mb-10"
      >
        Representative Matters
      </h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {matters.map((matter) => (
          <NotableMatterCard
            title={matter.title}
            practiceArea={matter.practiceArea}
            description={matter.description}
            outcome={matter.outcome}
          />
        ))}
      </div>
      <div class="mt-10">
        <Link
          href={viewAllHref}
          variant="nav"
          class="text-offwhite/80 hover:text-white"
        >
          View all representative matters →
        </Link>
      </div>
    </div>
  </section>
)}
