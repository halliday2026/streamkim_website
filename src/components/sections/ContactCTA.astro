---
import Button from '../ui/Button.astro';
import FormField from '../ui/FormField.astro';

export interface ContactCTAProps {
  heading: string;
  subhead?: string;
  formAction: string;
  practiceOptions: Array<{ slug: string; name: string }>;
  id?: string;
}

const { heading, subhead, formAction, practiceOptions, id } =
  Astro.props as ContactCTAProps;
---

<section
  aria-labelledby="contact-heading"
  id={id}
  class="py-16 lg:py-20 bg-navy"
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2
      id="contact-heading"
      class="font-display text-3xl lg:text-4xl font-normal text-white leading-snug tracking-[-0.01em] mb-4"
    >
      {heading}
    </h2>
    {subhead && (
      <p class="text-offwhite/80 text-lg mb-10">{subhead}</p>
    )}

    <!-- TODO: Wire formAction to Formspree or Web3Forms endpoint before launch -->
    <form
      action={formAction}
      method="POST"
      class="space-y-5"
      novalidate
    >
      <!-- Name -->
      <FormField
        id="contact-name"
        name="name"
        label="Full name"
        type="text"
        required
        placeholder="Jane Smith"
      />

      <!-- Email -->
      <FormField
        id="contact-email"
        name="email"
        label="Email address"
        type="email"
        required
        placeholder="you@example.com"
      />

      <!-- Phone (optional) -->
      <FormField
        id="contact-phone"
        name="phone"
        label="Phone number"
        type="tel"
        placeholder="(951) 555-0100"
      />

      <!-- Practice area dropdown — native <select> styled to match FormField.
           FormField does not yet support type="select". Refactor when it does.
           Practice options sourced from the practice-areas collection (single source of truth). -->
      <div class="flex flex-col gap-1">
        <label for="contact-practice" class="block text-sm font-medium text-white">
          Practice area
        </label>
        <select
          id="contact-practice"
          name="practice_area"
          class="block w-full border border-gray-300 px-3 py-2 text-base text-charcoal bg-white focus:outline-none focus:ring-2 focus:ring-navy focus:border-navy transition-colors duration-150"
        >
          <option value="">Select a practice area (optional)</option>
          {practiceOptions.map((p) => (
            <option value={p.slug}>{p.name}</option>
          ))}
        </select>
      </div>

      <!-- Matter description -->
      <FormField
        id="contact-matter"
        name="matter"
        label="Brief description of your matter"
        type="textarea"
        required
        rows={4}
        placeholder="Describe your legal matter in a few sentences."
      />

      <Button type="submit" variant="secondary" class="w-full sm:w-auto">
        Schedule a Consultation
      </Button>
    </form>

    <!-- Ethical disclaimer — required per CRPC 7.1. Not inside the form. -->
    <p class="mt-6 text-xs text-offwhite/60 leading-relaxed">
      Submission of this form does not create an attorney-client relationship.
      The information on this website is for general informational purposes only
      and does not constitute legal advice.
    </p>

  </div>
</section>
