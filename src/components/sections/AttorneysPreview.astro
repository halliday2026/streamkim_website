---
import AttorneyCard from './AttorneyCard.astro';
import Link from '../ui/Link.astro';

export interface AttorneysPreviewProps {
  attorneys: Array<{
    name: string;
    slug: string;
    title: string;
    practiceAreas: string[];
    portrait?: string;
  }>;
  viewAllHref: string;
}

const { attorneys, viewAllHref } = Astro.props as AttorneysPreviewProps;
---

{attorneys.length > 0 && (
  <section aria-labelledby="attorneys-heading" class="py-16 lg:py-20 bg-offwhite">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2
        id="attorneys-heading"
        class="font-display text-3xl lg:text-4xl font-normal text-navy leading-snug tracking-[-0.01em] mb-10"
      >
        Our Attorneys
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {attorneys.map((attorney) => (
          <AttorneyCard
            name={attorney.name}
            slug={attorney.slug}
            title={attorney.title}
            practiceAreas={attorney.practiceAreas}
            portrait={attorney.portrait}
          />
        ))}
      </div>
      <div class="mt-8">
        <Link href={viewAllHref} variant="body">View all attorneys</Link>
      </div>
    </div>
  </section>
)}
