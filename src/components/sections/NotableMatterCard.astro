---
export interface NotableMatterCardProps {
  title: string;
  practiceArea: string;
  description: string;
  outcome?: string;
}

const { title, practiceArea, description, outcome } = Astro.props as NotableMatterCardProps;
---

<article class="border border-white/20 p-6">
  <p class="text-xs font-semibold tracking-widest uppercase text-offwhite/60 mb-3">
    {practiceArea.replace(/-/g, ' ')}
  </p>
  <h3 class="font-display text-lg font-normal text-white leading-snug">
    {title}
  </h3>
  <p class="mt-3 text-sm text-offwhite/80 leading-relaxed">
    {description}
  </p>
  {outcome && (
    <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-offwhite/60">
      Result: {outcome}
    </p>
  )}
</article>
