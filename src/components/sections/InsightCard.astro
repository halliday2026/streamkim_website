---
export interface InsightCardProps {
  title: string;
  slug: string;
  publishDate: Date;
  author: { name: string; slug: string };
  practiceAreas: string[];
  excerpt: string;
}

const { title, slug, publishDate, author, practiceAreas, excerpt } =
  Astro.props as InsightCardProps;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(publishDate);
---

<article class="bg-white border border-gray-200 p-6 hover:border-charcoal transition-colors duration-150 flex flex-col">
  <!-- Practice tags -->
  {practiceAreas.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-3">
      {practiceAreas.slice(0, 2).map((area) => (
        <span class="text-xs font-semibold uppercase tracking-widest text-bordeaux">
          {area.replace(/-/g, ' ')}
        </span>
      ))}
    </div>
  )}

  <!-- Title -->
  <h3 class="font-display text-xl font-medium text-charcoal leading-snug flex-1">
    <a
      href={`/insights/${slug}`}
      class="hover:underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-charcoal focus-visible:outline-offset-2"
    >
      {title}
    </a>
  </h3>

  <!-- Excerpt -->
  <p class="mt-3 text-sm text-midgray leading-relaxed line-clamp-3">
    {excerpt}
  </p>

  <!-- Byline -->
  <div class="mt-4 pt-4 border-t border-gray-100 flex items-center justify-between">
    <a
      href={`/attorneys/${author.slug}`}
      class="text-sm text-charcoal hover:text-charcoal/70 hover:underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-charcoal focus-visible:outline-offset-2"
    >
      {author.name}
    </a>
    <time datetime={publishDate.toISOString()} class="text-sm text-midgray">
      {formattedDate}
    </time>
  </div>
</article>
