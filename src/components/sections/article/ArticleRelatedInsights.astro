---
import { getEntry } from 'astro:content';
import InsightCard from '../InsightCard.astro';

export interface Article {
  title: string;
  slug: string;
  publishDate: Date;
  author: string;
  practiceAreas: string[];
  excerpt: string;
}

export interface ArticleRelatedInsightsProps {
  articles: Article[];
}

const { articles } = Astro.props as ArticleRelatedInsightsProps;

const resolvedArticles = await Promise.all(
  articles.map(async (article) => {
    const attorney = await getEntry('attorneys', article.author);
    return {
      ...article,
      resolvedAuthor: attorney
        ? { name: attorney.data.name, slug: attorney.id }
        : { name: article.author, slug: article.author },
    };
  })
);
---

{resolvedArticles.length > 0 && (
  <section aria-labelledby="related-insights-heading" class="bg-white py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2
        id="related-insights-heading"
        class="font-display text-3xl font-medium text-charcoal leading-snug
               tracking-[-0.01em] mb-10"
      >
        Related Insights
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {resolvedArticles.map((article) => (
          <InsightCard
            title={article.title}
            slug={article.slug}
            publishDate={article.publishDate}
            author={article.resolvedAuthor}
            practiceAreas={article.practiceAreas}
            excerpt={article.excerpt}
          />
        ))}
      </div>
    </div>
  </section>
)}
