---
export interface ArticleAuthorCardProps {
  name: string;
  slug: string;
  title: string;
  leadParagraph: string;
  portrait?: string;
}

const { name, slug, title, leadParagraph, portrait } =
  Astro.props as ArticleAuthorCardProps;

const isPlaceholderPortrait = !portrait || portrait.startsWith('[PLACEHOLDER');

const truncatedBio =
  leadParagraph.length > 120
    ? leadParagraph.slice(0, 120).replace(/\s\S*$/, '') + '...'
    : leadParagraph;
---

<section
  aria-label="About the author"
  class="bg-bone border-t border-charcoal/10 py-12 lg:py-16"
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brass mb-6">
      About the Author
    </p>
    <div class="flex gap-5 items-start">
      <!-- Portrait or silhouette -->
      <div class="shrink-0">
        {isPlaceholderPortrait ? (
          <div
            class="w-16 h-16 bg-charcoal/10 flex items-center justify-center"
            aria-hidden="true"
          >
            <svg
              width="32"
              height="32"
              viewBox="0 0 40 40"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle cx="20" cy="14" r="7" fill="#6B7280" />
              <path
                d="M4 36c0-8.837 7.163-16 16-16s16 7.163 16 16"
                stroke="#6B7280"
                stroke-width="2"
                fill="none"
              />
            </svg>
          </div>
        ) : (
          <img
            src={portrait}
            alt={name}
            class="w-16 h-16 object-cover"
            loading="lazy"
          />
        )}
      </div>
      <!-- Bio info -->
      <div>
        <a
          href={`${import.meta.env.BASE_URL}attorneys/${slug}`}
          class="font-display text-lg font-medium text-charcoal hover:text-bordeaux
                 transition-colors duration-150"
        >
          {name}
        </a>
        <p class="text-sm text-midgray mt-0.5">{title}</p>
        <p class="mt-2 text-sm text-charcoal/80 leading-relaxed">{truncatedBio}</p>
        <a
          href={`${import.meta.env.BASE_URL}attorneys/${slug}`}
          class="inline-block mt-3 text-sm text-bordeaux hover:underline underline-offset-4
                 focus-visible:outline-2 focus-visible:outline-bordeaux focus-visible:outline-offset-2"
        >
          View bio →
        </a>
      </div>
    </div>
  </div>
</section>
