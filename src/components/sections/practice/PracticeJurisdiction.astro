---
export interface PracticeJurisdictionProps {
  jurisdictionNotes: string;
}

const { jurisdictionNotes } = Astro.props as PracticeJurisdictionProps;
---

{jurisdictionNotes && (
  <section aria-labelledby="jurisdiction-heading" class="bg-bone py-12 lg:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="border-l-2 border-brass pl-6">
        <h2
          id="jurisdiction-heading"
          class="font-display text-2xl font-medium text-charcoal leading-snug tracking-[-0.01em] mb-4"
        >
          Jurisdiction &amp; Geography
        </h2>
        <p class="text-base text-charcoal leading-relaxed">
          {jurisdictionNotes}
        </p>
      </div>
    </div>
  </section>
)}
