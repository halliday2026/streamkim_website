---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

export interface PracticeOverviewProps {
  Content: AstroComponentFactory;
}

const { Content } = Astro.props as PracticeOverviewProps;
---

<section aria-labelledby="overview-heading" class="bg-bone py-16 lg:py-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2
      id="overview-heading"
      class="font-display text-3xl font-medium text-charcoal leading-snug tracking-[-0.01em] mb-8"
    >
      Overview
    </h2>
    <!-- Rendered markdown body; .practice-prose targets descendant elements -->
    <div class="practice-prose">
      <Content />
    </div>
  </div>
</section>

<style>
  /* Prose-like styles for the rendered markdown body.
     Avoids @tailwindcss/typography dependency (not installed). */
  .practice-prose :global(p) {
    margin-bottom: 1.25rem;
    line-height: 1.65;
    color: #1A1A1A;
  }
  .practice-prose :global(h2) {
    font-family: 'Source Serif 4 Variable', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 500;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: #1A1A1A;
  }
  .practice-prose :global(h3) {
    font-family: 'Source Serif 4 Variable', Georgia, serif;
    font-size: 1.25rem;
    font-weight: 500;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: #1A1A1A;
  }
  .practice-prose :global(ul) {
    margin-bottom: 1.25rem;
    padding-left: 1.25rem;
    list-style-type: disc;
  }
  .practice-prose :global(li) {
    margin-bottom: 0.375rem;
    line-height: 1.65;
    color: #1A1A1A;
  }
  .practice-prose :global(a) {
    color: #6B0F1A;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
